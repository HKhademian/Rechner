---
import {
  sitePath,
} from "#/apps/appDefinition.ts";
import AppShell from "#/layouts/AppShell.astro";
import CalculatorCatalog from "#components/CalculatorCatalog";
import {
  PageHeader,
} from "#components/ui/PageHeader";
---
<AppShell
  title="Rechner | Life in Germany, calculated"
  description="Practical tools to plan life in Germany, with clear assumptions and source links."
  currentPath={sitePath("/")}
  mainClassName="calculator-catalog"
>
  <PageHeader
    title="Life in Germany, calculated."
    subtitle="Private, local-first calculators grounded in German statutory formulas."
  />
  <CalculatorCatalog client:load />
</AppShell>
