---
import AppShell from "#/layouts/AppShell.astro";
import {
  plainContentText,
} from "#utils/contentLinks";
import {
  TopicPage,
} from "#components/topics/TopicPages";
import {
  getTopic,
  topics,
} from "#engine/topics/registry";
import {
  topicPath,
} from "#utils/topicPath";

export function getStaticPaths() {
  return topics.map((topic) => ({ params: { topicId: topic.id } }));
}
const topic = getTopic(Astro.params.topicId ?? "");
if (!topic) {
  throw new Error("Unknown topic");
}
if (topic.parentId) {
  return Astro.redirect(topicPath(topic.id), 301);
}
---
<AppShell
  title={`${topic.title} | Rechner`}
  description={plainContentText(topic.description)}
  currentPath={topicPath(topic.id)}
>
  <TopicPage topic={topic} />
</AppShell>
