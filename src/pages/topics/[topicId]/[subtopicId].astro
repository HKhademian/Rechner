---
import BaseDocument from "#/layouts/BaseDocument.astro";
import {
  plainContentText,
} from "#utils/contentLinks";
import {
  TopicPage,
} from "#components/topics/TopicPages";
import {
  getTopic,
  topics,
} from "#engine/topics/registry";

export function getStaticPaths() {
  return topics.flatMap((topic) => topic.parentId
    ? [{ params: { topicId: topic.parentId, subtopicId: topic.id } }]
    : []);
}
const topic = getTopic(Astro.params.subtopicId ?? "");
if (!topic || topic.parentId !== Astro.params.topicId) {
  throw new Error("Unknown subtopic");
}
---
<BaseDocument title={`${topic.title} | Rechner`} description={plainContentText(topic.description)}>
  <TopicPage topic={topic} client:load />
</BaseDocument>
