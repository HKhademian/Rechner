---
import AppShell from "#/layouts/AppShell.astro";
import {
  plainContentText,
} from "#utils/contentLinks";
import {
  TopicPage,
} from "#components/topics/TopicPages";
import {
  getTopic,
  topics,
} from "#engine/topics/registry";
import {
  topicPath,
} from "#utils/topicPath";

export function getStaticPaths() {
  return topics.flatMap((topic) => topic.parentId
    ? [{ params: { topicId: topic.parentId, subtopicId: topic.id } }]
    : []);
}
const topic = getTopic(Astro.params.subtopicId ?? "");
if (!topic || topic.parentId !== Astro.params.topicId) {
  throw new Error("Unknown subtopic");
}
---
<AppShell
  title={`${topic.title} | Rechner`}
  description={plainContentText(topic.description)}
  currentPath={topicPath(topic.id)}
>
  <TopicPage topic={topic} />
</AppShell>
