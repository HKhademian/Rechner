  calculatorPath,
} from "#/apps/appDefinition.ts";
import VisaApp from "#/apps/visa/App.tsx";
import {
  visaApp,
} from "#/apps/visa/manifest.ts";
import AppShell from "#/layouts/AppShell.astro";
---
