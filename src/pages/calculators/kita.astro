---
import {
  calculatorPath,
} from "#/apps/appDefinition.ts";
import KitaApp from "#/apps/kita/App.tsx";
import {
  kitaApp,
} from "#/apps/kita/manifest.ts";
import AppShell from "#/layouts/AppShell.astro";
---
<AppShell
  title={`${kitaApp.title} | Rechner`}
  description={kitaApp.description}
  currentPath={calculatorPath(kitaApp.id)}
  footerNote="Demo tool: municipal fee tables are illustrative reference models; meals (Verpflegungsgeld) are always excluded under § 10 Abs. 1 Nr. 5 EStG."
>
  <KitaApp client:load />
</AppShell>
