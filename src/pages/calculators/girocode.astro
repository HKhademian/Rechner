---
import {
  calculatorPath,
} from "#/apps/appDefinition.ts";
import GiroCodeApp from "#/apps/girocode/App.tsx";
import {
  giroCodeApp,
} from "#/apps/girocode/manifest.ts";
import AppShell from "#/layouts/AppShell.astro";
---
<AppShell
  title={`${giroCodeApp.title} | Rechner`}
  description={giroCodeApp.description}
  currentPath={calculatorPath(giroCodeApp.id)}
  mainClassName="girocode-page"
>
  <GiroCodeApp client:load />
</AppShell>
