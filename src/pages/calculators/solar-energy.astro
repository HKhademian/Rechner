---
import {
  calculatorPath,
} from "#/apps/appDefinition.ts";
import SolarEnergyApp from "#/apps/solar-energy/App.tsx";
import {
  solarEnergyApp,
} from "#/apps/solar-energy/manifest.ts";
import AppShell from "#/layouts/AppShell.astro";
---
<AppShell
  title={`${solarEnergyApp.title} | Rechner`}
  description={solarEnergyApp.description}
  currentPath={calculatorPath(solarEnergyApp.id)}
  footerNote="Adjust your assumed grid electricity price in Statutory Assumptions below."
>
  <SolarEnergyApp client:load />
</AppShell>
