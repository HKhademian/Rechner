---
import {
  calculatorPath,
} from "#/apps/appDefinition.ts";
import MortgageCalculator from "#/apps/mortgage/MortgageCalculator.tsx";
import {
  mortgageApp,
} from "#/apps/mortgage/manifest.ts";
import AppShell from "#/layouts/AppShell.astro";
---
<AppShell
  title={`${mortgageApp.title} | Rechner`}
  description={mortgageApp.description}
  currentPath={calculatorPath(mortgageApp.id)}
  wide
>
  <MortgageCalculator client:load />
</AppShell>
