---
import {
  AppId,
  calculatorPath,
} from "#/apps/appDefinition.ts";
import MunichMap from "#/apps/munich-map/App.tsx";
import {
  munichMapApp,
} from "#/apps/munich-map/manifest.ts";
import AppShell from "#/layouts/AppShell.astro";
---
<AppShell
  title={`${munichMapApp.title} | Rechner`}
  description={munichMapApp.description}
  currentPath={calculatorPath(AppId.MunichMap)}
  wide
  mainClassName="munich-map-page"
  shellClassName="munich-map-shell"
  openStreetMapTiles
>
  <MunichMap client:load />
</AppShell>
