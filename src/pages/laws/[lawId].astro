---
import LawReferencePage from "#components/laws/LawReferencePage";
import {
  sitePath,
} from "#/apps/appDefinition.ts";
import {
  getAllLawEntries,
  getLawEntry,
} from "#engine/laws/registry";
import {
  type LawId,
} from "#engine/laws/types";
import "#styles/global.css";

export function getStaticPaths() {
  return getAllLawEntries().map((entry) => ({
    params: { lawId: entry.id },
  }));
}

const lawId = Astro.params.lawId as LawId;
const entry = getLawEntry(lawId);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={sitePath("/favicon.svg")} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="tdm-reservation" content="1" />
    <title>{entry.citation} — {entry.title} | Rechner</title>
    <meta name="description" content={entry.summary} />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'" />
  </head>
  <body><LawReferencePage client:load initialLawId={entry.id} /></body>
</html>
