---
import LawReferencePage from "#components/laws/LawReferencePage";
import BaseDocument from "#/layouts/BaseDocument.astro";
import {
  getAllLawEntries,
  getLawEntry,
} from "#engine/laws/registry";
import {
  type LawId,
} from "#engine/laws/types";

export function getStaticPaths() {
  return getAllLawEntries().map((entry) => ({
    params: { lawId: entry.id },
  }));
}

const lawId = Astro.params.lawId as LawId;
const entry = getLawEntry(lawId);
---
<BaseDocument
  title={`${entry.citation} — ${entry.title} | Rechner`}
  description={entry.summary}
>
  <LawReferencePage client:load initialLawId={entry.id} />
</BaseDocument>
