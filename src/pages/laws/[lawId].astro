---
import LawPageLayout from "#/layouts/LawPageLayout.astro";
import {
  getAllLawEntries,
  getLawEntry,
} from "#engine/laws/registry";
import {
  type LawId,
} from "#engine/laws/types";

export function getStaticPaths() {
  return getAllLawEntries().map((entry) => ({
    params: { lawId: entry.id },
  }));
}

const lawId = Astro.params.lawId as LawId;
const entry = getLawEntry(lawId);
---
<LawPageLayout
  title={`${entry.citation} — ${entry.title} | Rechner`}
  description={entry.summary}
  lawId={entry.id}
/>
