---
import {
  sitePath,
} from "#/apps/appDefinition.ts";
import AppShell from "#/layouts/AppShell.astro";
import {
  ParameterValue,
} from "#components/reference/ParameterValue";
import {
  ConstantPageIntro,
  ConstantPageLinks,
} from "#components/reference/ReferencePages";
import {
  getAllParameterDefinitions,
} from "#engine/parameters/registry";

export function getStaticPaths() {
  return getAllParameterDefinitions().map((parameter) => ({ params: { parameterId: parameter.id }, props: { parameter } }));
}
const { parameter } = Astro.props;
---
<AppShell
  title={`${parameter.label} | Rechner`}
  description={parameter.description}
  currentPath={sitePath("/constants/")}
>
  <div class="reference-page">
    <ConstantPageIntro id={parameter.id} />
    <ParameterValue client:load id={parameter.id} />
    <ConstantPageLinks id={parameter.id} />
  </div>
</AppShell>
