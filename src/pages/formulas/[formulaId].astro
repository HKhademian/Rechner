---
import {
  sitePath,
} from "#/apps/appDefinition.ts";
import AppShell from "#/layouts/AppShell.astro";
import {
  FormulaPage,
  REFERENCE_FORMULAS,
} from "#components/reference/ReferencePages";
import {
  STATUTORY_FORMULA_DESCRIPTORS,
} from "#engine/formulas/context/statutoryEvaluators";

export function getStaticPaths() {
  return REFERENCE_FORMULAS.map((id) => ({ params: { formulaId: id }, props: { id } }));
}
const { id } = Astro.props;
const formula = STATUTORY_FORMULA_DESCRIPTORS[id];
---
<AppShell
  title={`${formula.label} | Rechner`}
  description={formula.description}
  currentPath={sitePath("/formulas/")}
>
  <FormulaPage id={id} />
</AppShell>
