---
import BaseDocument from "#/layouts/BaseDocument.astro";
import {
  FormulaPage,
  REFERENCE_FORMULAS,
} from "#components/reference/ReferencePages";
import {
  STATUTORY_FORMULA_DESCRIPTORS,
} from "#engine/formulas/context/statutoryEvaluators";
export function getStaticPaths() {
  return REFERENCE_FORMULAS.map((id) => ({ params: { formulaId: id }, props: { id } }));
}
const { id } = Astro.props;
const formula = STATUTORY_FORMULA_DESCRIPTORS[id];
---
<BaseDocument title={`${formula.label} | Rechner`} description={formula.description}>
  <FormulaPage client:load id={id} />
</BaseDocument>
