{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@store/*": ["src/store/*"],
      "@components/*": ["src/components/*"],
      "@engine/*": ["src/engine/*"],
      "@styles/*": ["src/styles/*"],
      "@/*": ["src/*"],
      "#store/*": ["src/store/*"],
      "#components/*": ["src/components/*"],
      "#engine/*": ["src/engine/*"],
      "#styles/*": ["src/styles/*"],
      "#/*": ["src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": [
      "node"
    ]
  }
}