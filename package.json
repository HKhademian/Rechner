{
  "name": "lucid-hertz",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "imports": {
    "#store/*": "./src/store/*.ts",
    "#components/*": "./src/components/*.tsx",
    "#engine/*": "./src/engine/*.ts",
    "#cli/*": "./src/cli/*.ts",
    "#styles/*": "./src/styles/*",
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 astro preview",
    "astro": "ASTRO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 astro",
    "sim": "ASTRO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 node src/cli/runner.ts",
    "test": "ASTRO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 node --test 'src/**/*.test.ts' 'test/**/*.test.ts'",
    "test:unit": "ASTRO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 node --test 'src/**/*.test.ts'",
    "test:scenario": "ASTRO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 node --test 'test/scenario/**/*.test.ts'",
    "test:combination": "ASTRO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 node --test 'test/combination/**/*.test.ts'",
    "test:benchmark": "ASTRO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 node --test 'test/benchmark/**/*.test.ts'",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 tsc --noEmit",
    "lint": "ASTRO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 eslint \"src/**/*.{ts,tsx,js,mjs,astro}\" \"test/**/*.ts\"",
    "lint:fix": "ASTRO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 eslint --fix \"src/**/*.{ts,tsx,js,mjs,astro}\" \"test/**/*.ts\"",
    "check": "npm run check:audit",
    "check:types": "npm run typecheck",
    "check:lint": "npm run lint",
    "check:format": "npm run lint",
    "check:test": "npm run test",
    "check:build": "npm run build",
    "check:audit": "node --no-warnings src/cli/qualityAudit.ts",
    "verify": "npm run check:audit",
    "format": "npm run lint:fix",
    "format:check": "npm run lint",
    "fix": "npm run lint:fix",
    "apply": "npm run fix && npm run check"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.1",
    "@preact/signals": "^2.9.4",
    "astro": "^7.1.2",
    "lohnsteuer": "^1.0.0",
    "preact": "^10.29.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
