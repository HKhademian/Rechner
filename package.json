{
  "name": "lucid-hertz",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "imports": {
    "#store/*": "./src/store/*.ts",
    "#components/*": "./src/components/*.tsx",
    "#engine/*": "./src/engine/*.ts",
    "#cli/*": "./src/cli/*.ts",
    "#styles/*": "./src/styles/*",
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 astro preview",
    "astro": "ASTRO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 astro",
    "sim": "ASTRO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 node src/cli/runner.ts",
    "test": "ASTRO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 node --test 'test/**/*.test.ts'",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 tsc --noEmit",
    "check": "npm run check:audit",
    "check:types": "npm run typecheck",
    "check:format": "npm run format:check",
    "check:test": "npm run test",
    "check:build": "npm run build",
    "check:audit": "node --no-warnings src/cli/qualityAudit.ts",
    "verify": "npm run check:audit",
    "format": "ASTRO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 prettier --write \"src/**/*.{ts,tsx,css}\" \"test/**/*.ts\"",
    "format:check": "ASTRO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 prettier --check \"src/**/*.{ts,tsx,css}\" \"test/**/*.ts\"",
    "fix": "npm run format",
    "apply": "npm run format && npm run check"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.1",
    "@preact/signals": "^2.9.4",
    "astro": "^7.1.2",
    "lohnsteuer": "^1.0.0",
    "preact": "^10.29.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.2.0",
    "prettier": "^3.5.0",
    "typescript": "^7.0.2"
  }
}
